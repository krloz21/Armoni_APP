        "jsCode": "const v = $('Validar movimiento').first().json;\nlet lugarId = null;\ntry { const c = $('Crear lugar').first(); if (c && c.json && c.json.id) lugarId = c.json.id; } catch (e) {}\nif (!lugarId) { try { const d = $('Decidir lugar').first(); if (d && d.json && d.json.lugarId) lugarId = d.json.lugarId; } catch (e) {} }\nconst props = {\n  'Concepto': { title: [{ text: { content: v.concepto } }] },\n  'Monto': { number: v.monto },\n  'Tipo': { select: { name: v.tipo } },\n  'Categoría': { select: { name: v.categoria } },\n  'Fecha': { date: { start: v.fecha } },\n  'Notas': { rich_text: v.notas ? [{ text: { content: v.notas } }] : [] },\n  'Resumen financiero': { relation: [{ id: '39b39f80-d3a5-80fb-9a19-f3198aa16cc7' }] }\n};\nif (lugarId) props['Restaurante'] = { relation: [{ id: lugarId }] };\nif (v.categoria === 'Salidas Ema') props['Personas'] = { number: 0 };\nreturn [{ json: { cuerpo: JSON.stringify({ parent: { database_id: '922bb9e4e3d648feab56d6b2d75be29d' }, properties: props }) } }];\n"
