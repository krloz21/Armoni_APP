      "parameters": {
        "jsCode": "const v = $('Validar movimiento').first().json;\nlet lugarId = null;\nfor (const n of ['Crear lugar con puntuación', 'Crear lugar sin puntuación', 'Crear restaurante con puntuación', 'Crear restaurante sin puntuación']) {\n  try { const c = $(n).first(); if (c && c.json && c.json.id) { lugarId = c.json.id; break; } } catch (e) {}\n}\nif (!lugarId) { try { const d = $('Decidir lugar').first(); if (d && d.json && d.json.lugarId) lugarId = d.json.lugarId; } catch (e) {} }\nreturn [{ json: { concepto: v.concepto, monto: v.monto, tipo: v.tipo, categoria: v.categoria, fecha: v.fecha, notas: v.notas || '',\n  personas: v.personas != null ? v.personas : (v.categoria === 'Salidas Ema' ? 0 : null), lugarId, tieneLugar: !!lugarId, fechaSalida: v.fechaSalida || '', salida: v.salida || '' } }];\n"
