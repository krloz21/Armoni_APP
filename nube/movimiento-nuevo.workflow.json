    {
      "parameters": {
        "jsCode": "// Lee una propiedad venga como página completa de Notion (properties) o simplificada de n8n (property_xxx)\nconst clave = (n) => 'property_' + String(n).toLowerCase().replace(/\\s+/g, '_');\nconst txt = (a) => ((a || []).map(t => t.plain_text).join('') || '').trim();\nconst leer = (it, nombre, tipo) => {\n  const pr = it.properties && it.properties[nombre];\n  if (pr) {\n    if (tipo === 'titulo') return txt(pr.title);\n    if (tipo === 'texto') return txt(pr.rich_text);\n    if (tipo === 'numero') return pr.number != null ? pr.number : null;\n    if (tipo === 'fecha') return pr.date && pr.date.start ? pr.date.start.slice(0, 10) : null;\n    if (tipo === 'select') return pr.select ? pr.select.name : (pr.status ? pr.status.name : null);\n    if (tipo === 'relacion') return pr.relation && pr.relation[0] ? pr.relation[0].id : null;\n  }\n  let v = it[clave(nombre)];\n  if (v === undefined && tipo === 'titulo') v = it.name;\n  if (v === undefined || v === null || v === '') return null;\n  if (tipo === 'fecha') { const s = typeof v === 'object' ? (v.start || '') : String(v); return s ? s.slice(0, 10) : null; }\n  if (tipo === 'relacion') { const r = Array.isArray(v) ? v[0] : v; return r ? (typeof r === 'object' ? r.id : String(r)) : null; }\n  if (tipo === 'numero') return typeof v === 'number' ? v : (Number(v) || null);\n  return String(v);\n};\n\n// ¿Ese pago ya estaba anotado? (mismo tipo, casi el mismo valor y fechas cercanas: por ejemplo, llegó solo desde el correo de PSE)\nconst v = $('Validar movimiento').first().json;\nif (v.forzar) return [{ json: { repetido: false } }];\nconst dia = f => new Date(f + 'T12:00:00').getTime();\nconst cerca = $input.all().map(i => i.json).filter(x => x && x.id).map(x => ({\n  concepto: leer(x, 'Concepto', 'titulo') || '', monto: leer(x, 'Monto', 'numero') || 0, tipo: leer(x, 'Tipo', 'select') || '',\n  fecha: leer(x, 'Fecha', 'fecha') || '', categoria: leer(x, 'Categoría', 'select') || '', notas: leer(x, 'Notas', 'texto') || ''\n})).filter(x => x.tipo === v.tipo && x.fecha && Math.abs(x.monto - v.monto) <= Math.max(100, v.monto * 0.005) && Math.abs(dia(x.fecha) - dia(v.fecha)) <= 4 * 864e5);\nif (!cerca.length) return [{ json: { repetido: false } }];\nconst x = cerca.sort((a, b) => Math.abs(dia(a.fecha) - dia(v.fecha)) - Math.abs(dia(b.fecha) - dia(v.fecha)))[0];\nconst automatico = /pse|correo|gmail|autom|bancolombia|nequi|nu\\b/i.test(x.notas + ' ' + x.concepto);\nreturn [{ json: { repetido: true, parecido: { concepto: x.concepto, monto: x.monto, fecha: x.fecha, categoria: x.categoria, automatico } } }];\n"
      },
