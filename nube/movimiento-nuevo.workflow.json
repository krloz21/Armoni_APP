    {
      "parameters": {
        "jsCode": "const v = $('Validar movimiento').first().json;\nconst lugs = $input.first().json.results || [];\nconst norm = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim().split(' ').map(w => w.replace(/s$/, '')).join(' ');\nconst buscado = norm(v.lugar);\nlet lugarId = null;\nfor (const l of lugs) {\n  const nombre = ((l.properties && l.properties['Nombre'] && l.properties['Nombre'].title) || []).map(t => t.plain_text).join('');\n  const n = norm(nombre);\n  if (n && (n === buscado || (buscado.length > 3 && (n.includes(buscado) || buscado.includes(n))))) { lugarId = l.id; break; }\n}\nlet cuerpoLugar = null;\nif (!lugarId) {\n  const props = {\n    'Nombre': { title: [{ text: { content: v.lugar } }] },\n    'Clase': { select: { name: 'Plan Ema' } }\n  };\n  if (v.puntuacion != null) props['Puntuación'] = { number: v.puntuacion };\n  if (v.comentario) props['Notas'] = { rich_text: [{ text: { content: v.comentario } }] };\n  cuerpoLugar = JSON.stringify({ parent: { database_id: '4912f5c4e91d41598e49bb8e97d02f31' }, properties: props });\n}\nreturn [{ json: { lugarId, crear: !lugarId, cuerpoLugar } }];\n"
      },
