  {
   "parameters": {
    "jsCode": "// Valida lo que manda Armoni y lo deja listo para Notion\nconst TOKEN = 'mercado-7d41c2a9e05b';\nconst CATEGORIAS = ['Hogar', 'Alimentación', 'Salidas', 'Salud', 'Ahorro', 'Otros'];   // las automatizadas (Servicios, Hijo, Carro, Tarjetas) no se aceptan\n\nlet b = $input.first().json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\n\nconst falla = (error) => [{ json: { ok: false, error } }];\n\nif (b.token !== TOKEN) return falla('token');\nconst concepto = String(b.concepto || '').trim().slice(0, 80);\nconst categoria = String(b.categoria || '');\nconst fecha = String(b.fecha || '');\nconst monto = Math.round(Number(b.monto));\nconst notas = String(b.notas || '').trim().slice(0, 300);\n\nif (!concepto) return falla('concepto');\nif (!CATEGORIAS.includes(categoria)) return falla('categoria');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) return falla('fecha');\nif (!(monto > 0) || monto > 1000000000) return falla('monto');\n\nreturn [{ json: { ok: true, concepto, categoria, fecha, monto, notas } }];\n"
   },
