    {
      "parameters": {
        "jsCode": "// Completa un gasto de salidas que quedó sin restaurante: lo enlaza a su lugar (lo crea si es nuevo) y anota cuántos comieron\nconst TOKEN = 'mercado-7d41c2a9e05b';\nlet b = $input.first().json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nconst falla = (error) => [{ json: { ok: false, error } }];\nif (b.token !== TOKEN) return falla('token');\nconst id = String(b.id || '').trim();\nif (!/^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$/i.test(id)) return falla('id');\nconst lugar = String(b.lugar || '').replace(/[<>{}\\[\\]]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 80);\nif (lugar.length < 2) return falla('lugar');\nconst pers = Math.round(Number(b.personas));\nconst personas = pers >= 1 && pers <= 30 ? pers : null;\nconst punt = Number(b.puntuacion);\nconst puntuacion = punt >= 1 && punt <= 10 ? Math.round(punt * 2) / 2 : null;\nconst comentario = String(b.comentario || '').trim().slice(0, 200);\n// nombre nuevo del gasto (cuando dos registros parecidos fueron a lugares distintos): «Helado · Crepes»\nconst concepto = String(b.concepto || '').replace(/[<>{}\\[\\]]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 80);\nreturn [{ json: { ok: true, id, lugar, personas, puntuacion, comentario, concepto, categoria: 'Salidas', salida: '' } }];\n"
      },
