    {
      "parameters": {
        "jsCode": "const v = $('Validar movimiento').first().json;\nlet lugarId = null;\nfor (const n of ['Crear restaurante con puntuación', 'Crear restaurante sin puntuación']) {\n  try { const c = $(n).first(); if (c && c.json && c.json.id) { lugarId = c.json.id; break; } } catch (e) {}\n}\nif (!lugarId) { try { const d = $('Decidir lugar').first(); if (d && d.json && d.json.lugarId) lugarId = d.json.lugarId; } catch (e) {} }\nreturn [{ json: { id: v.id, lugarId, personas: v.personas, ok: !!lugarId } }];\n"
      },
