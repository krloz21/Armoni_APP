    {
      "parameters": {
        "jsCode": "// Lee una propiedad venga como página completa de Notion (properties) o simplificada de n8n (property_xxx)\nconst clave = (n) => 'property_' + String(n).toLowerCase().replace(/\\s+/g, '_');\nconst txt = (a) => ((a || []).map(t => t.plain_text).join('') || '').trim();\nconst leer = (it, nombre, tipo) => {\n  const pr = it.properties && it.properties[nombre];\n  if (pr) {\n    if (tipo === 'titulo') return txt(pr.title);\n    if (tipo === 'texto') return txt(pr.rich_text);\n    if (tipo === 'numero') return pr.number != null ? pr.number : null;\n    if (tipo === 'fecha') return pr.date && pr.date.start ? pr.date.start.slice(0, 10) : null;\n    if (tipo === 'select') return pr.select ? pr.select.name : (pr.status ? pr.status.name : null);\n    if (tipo === 'relacion') return pr.relation && pr.relation[0] ? pr.relation[0].id : null;\n  }\n  let v = it[clave(nombre)];\n  if (v === undefined && tipo === 'titulo') v = it.name;\n  if (v === undefined || v === null || v === '') return null;\n  if (tipo === 'fecha') { const s = typeof v === 'object' ? (v.start || '') : String(v); return s ? s.slice(0, 10) : null; }\n  if (tipo === 'relacion') { const r = Array.isArray(v) ? v[0] : v; return r ? (typeof r === 'object' ? r.id : String(r)) : null; }\n  if (tipo === 'numero') return typeof v === 'number' ? v : (Number(v) || null);\n  return String(v);\n};\n\nconst v = $('Validar movimiento').first().json;\nconst lugs = $input.all().map(i => i.json).filter(x => x && x.id);\nconst norm = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim().split(' ').map(w => w.replace(/s$/, '')).join(' ');\nconst buscado = norm(v.lugar);\n// primero el nombre exacto; si no, que uno contenga al otro como palabras completas (así «Pan» no se confunde con «Pandebono»)\nconst conPalabras = (a, b) => (' ' + a + ' ').includes(' ' + b + ' ');\nconst nombres = lugs.map(l => ({ id: l.id, n: norm(leer(l, 'Nombre', 'titulo')) })).filter(x => x.n);\nlet lugarId = (nombres.find(x => x.n === buscado) || {}).id || null;\nif (!lugarId && buscado.length > 3) {\n  const m = nombres.find(x => x.n.length > 3 && (conPalabras(x.n, buscado) || conPalabras(buscado, x.n)));\n  if (m) lugarId = m.id;\n}\nreturn [{ json: { lugarId, crear: !lugarId, esEma: v.salida === 'Con Ema' || v.categoria === 'Salidas Ema', nombre: v.lugar, puntuacion: v.puntuacion, tienePuntuacion: v.puntuacion != null, comentario: v.comentario || '' } }];\n"
      },
