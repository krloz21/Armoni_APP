      "parameters": {
        "jsCode": "// Valida lo que manda Armoni: el lugar (id de Notion), la nota de 1 a 10 y un comentario opcional\nlet b = $input.first().json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nif (b.token !== 'mercado-7d41c2a9e05b') return [{ json: { ok: false, error: 'token' } }];\nconst id = String(b.id || '');\nif (!/^[0-9a-f-]{32,36}$/i.test(id)) return [{ json: { ok: false, error: 'lugar' } }];\nconst p = Number(b.puntuacion);\nif (!(p >= 1 && p <= 10)) return [{ json: { ok: false, error: 'puntuacion' } }];\nconst notas = String(b.notas || '').trim().slice(0, 500);\nreturn [{ json: { ok: true, id, puntuacion: Math.round(p * 2) / 2, notas, conNotas: !!notas } }];"
      },
