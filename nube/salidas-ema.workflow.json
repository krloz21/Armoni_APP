        "jsCode": "const q = $input.first().json.query || {};\nif (q.token !== 'mercado-7d41c2a9e05b') return [{ json: { ok: false } }];\n// últimos 12 meses completos + el actual\nconst d = new Date(Date.now() - 5 * 3600 * 1000);   // hora de Colombia\nd.setUTCDate(1); d.setUTCMonth(d.getUTCMonth() - 11);\nconst desde = d.toISOString().slice(0, 10);\nconst consulta = {\n  page_size: 100,\n  filter: { and: [\n    { property: 'Categoría', select: { equals: 'Salidas Ema' } },\n    { property: 'Fecha', date: { on_or_after: desde } }\n  ] },\n  sorts: [{ property: 'Fecha', direction: 'ascending' }]\n};\nreturn [{ json: { ok: true, consulta: JSON.stringify(consulta) } }];\n"
