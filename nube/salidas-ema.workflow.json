    {
      "parameters": {
        "jsCode": "const filas = $input.first().json.results || [];\nconst por = {};\nfor (const p of filas) {\n  const pr = p.properties || {};\n  const f = pr['Fecha'] && pr['Fecha'].date && pr['Fecha'].date.start ? pr['Fecha'].date.start.slice(0, 10) : null;\n  if (!f) continue;\n  const mes = f.slice(0, 7);\n  const m = por[mes] || (por[mes] = { mes, veces: 0, total: 0, dias: [] });\n  m.total += (pr['Monto'] && pr['Monto'].number) || 0;\n  if (!m.dias.includes(f)) m.dias.push(f);\n}\nfor (const m of Object.values(por)) m.veces = m.dias.length;   // una salida = un día (aunque se registren varios gastos ese día)\nconst meses = Object.values(por).sort((a, b) => a.mes.localeCompare(b.mes));\nreturn [{ json: { meses } }];\n"
      },
